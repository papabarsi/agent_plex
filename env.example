# Claude API
ANTHROPIC_API_KEY=sk-ant-xxxxx

# Radarr
RADARR_URL=http://192.168.x.x:7878
RADARR_API_KEY=your-radarr-api-key

# Sonarr
SONARR_URL=http://192.168.x.x:8989
SONARR_API_KEY=your-sonarr-api-key

# Plex
PLEX_URL=http://192.168.x.x:32400
PLEX_TOKEN=your-plex-token

# Langfuse (observability)
# URL where Langfuse UI is reachable (use your Docker host LAN IP, not localhost)
LANGFUSE_URL=http://192.168.x.x:3001

# Auto-init: seeds org, project, and admin user on first startup
LANGFUSE_INIT_ORG_ID=generate-a-uuid
LANGFUSE_INIT_PROJECT_ID=generate-a-uuid
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-xxxxx
LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-xxxxx
LANGFUSE_INIT_USER_EMAIL=admin@example.com
LANGFUSE_INIT_USER_NAME=admin
LANGFUSE_INIT_USER_PASSWORD=changeme

# Agent credentials (must match the INIT keys above)
LANGFUSE_PUBLIC_KEY=pk-lf-xxxxx
LANGFUSE_SECRET_KEY=sk-lf-xxxxx
